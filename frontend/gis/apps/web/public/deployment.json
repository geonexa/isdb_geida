          "url": "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2025_3857/default/g/{z}/{y}/{x}.jpg",
          "tileSize": "256"
        }
      },
      {
        "id": "geida-wms-gebco",
        "name": "GEBCO Ocean Bathymetry",
        "kind": "wms",
        "category": "Imagery",
        "fields": {
          "endpoint": "https://wms.gebco.net/mapserv",
          "layers": "GEBCO_LATEST",
          "styles": "",
          "format": "image/png",
          "transparent": true,
          "tileSize": "256",
          "version": "1.3.0"
