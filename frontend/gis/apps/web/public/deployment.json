    "catalog": [
      {
        "id": "geida-xyz-osm",
        "name": "OpenStreetMap",
        "kind": "xyz",
        "category": "Basemaps",
        "fields": {
          "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
          "tileSize": "256",
          "shortUrl": false
        }
      },
      {
        "id": "geida-wmts-s2cloudless",
        "name": "Sentinel-2 cloudless (EOX)",
        "kind": "wmts",
        "category": "Imagery",
