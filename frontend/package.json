{
  "name": "geida-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node gis/scripts/apply-dependency-patches.mjs",
    "engine": "node scripts/copy-engine.mjs",
    "dev": "node scripts/predev.mjs && vite",
    "build": "node scripts/predev.mjs --build && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc -b",
    "test:gis": "cd gis && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@tanstack/react-query": "^5.104.5",
    "geolibre-wasm": "1.7.1",
    "geotiff": "^3.0.5",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.11.2",
    "ol": "10.2.1",
    "patch-package": "^8.0.1",
    "proj4": "^2.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "workspaces": [
    "gis/apps/web",
    "gis/packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@loaders.gl/compression": {
      "fflate": "^0.8.3"
    },
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.7",
    "filelist": "^2.0.2",
    "maplibre-gl": "$maplibre-gl",
    "sweepline-intersections": "^1.5.0",
    "texture-compressor": {
      "image-size": "^2.0.4"
    },
    "three": "^0.186.1",
    "uuid": "^14.0.0",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
