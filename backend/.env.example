# Copy to .env and fill in. Never commit .env.

#---------------
# Environment: development (SQLite + SpatiaLite) or production (PostgreSQL + PostGIS)
#---------------
DJANGO_ENV=development
DATABASE_NAME=db.sqlite3

#---------------
# Production
#---------------
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=<long random string: python -c "import secrets; print(secrets.token_urlsafe(50))">
# POSTGRES_DB=geida
# POSTGRES_USER=geida
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Hosts and origins (defaults cover localhost, Vite on :5173 and geida.terrawatch.net)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,geida.terrawatch.net
# DJANGO_CSRF_TRUSTED_ORIGINS=https://geida.terrawatch.net,http://localhost:5173
# Public address of the React app for emailed links (default: the request's own address)
# FRONTEND_URL=https://geida.terrawatch.net

#---------------
# Raster layers (Data Catalog): TiTiler renders cloud-optimised GeoTIFFs,
# STAC finds tiled datasets (Copernicus DEM). Defaults shown.
#---------------
# TITILER_URL=https://titiler.waterinag.org
# STAC_API_URL=https://earth-search.aws.element84.com/v1

#---------------
# Email (leave EMAIL_HOST_USER empty to print emails in the runserver console)
#---------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=GEIDA <no-reply@geida.terrawatch.net>

#---------------
# Analysis runs
#---------------
# Celery broker (brew services start redis / apt install redis-server)
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=true          # run analyses inline, no Redis or worker needed
# ANALYSIS_TIME_LIMIT=3600               # seconds
# Large local datasets, default backend/data/ (see backend/data/README.md)
# DATA_DIR=/srv/geida-data
# OpenStreetMap source: geofabrik (country extracts, Overpass fallback) or overpass (live only)
# OSM_SOURCE=geofabrik

#---------------
# Only if GeoDjango can't find its libraries (macOS conda example)
#---------------
# GDAL_LIBRARY_PATH=/opt/anaconda3/envs/geida/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/anaconda3/envs/geida/lib/libgeos_c.dylib
# SPATIALITE_LIBRARY_PATH=/opt/anaconda3/envs/geida/lib/mod_spatialite.dylib
