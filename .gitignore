# --- Secrets ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*service-account*.json
# Keys and service accounts live in cred/; only its README is tracked.
cred/*
!cred/README.md

# --- Local-only notes ---------------------------------------------------------
local

# --- Python / Django ----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
# Old local database files (GEIDA uses PostgreSQL + PostGIS); kept ignored so a leftover file is never committed
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/
*.log

# Reference data lives outside the repository (REFERENCE_DATA_DIR, geida_static_data/); the runtime
# cache DATA_DIR is .cache/. backend/data/ kept ignored in case an old local folder is left behind.
backend/data/

# --- Node / frontend ----------------------------------------------------------
node_modules/
frontend/dist/
frontend/public/vendor/
# GIS workspace (GeoLibre) build output and generated files
frontend/gis/apps/web/dist/
frontend/gis/apps/web/public/jupyterlite/
frontend/gis/apps/web/src/lib/pyodide/vector_ops.generated.py
frontend/gis/packages/embed/dist/
*.tsbuildinfo

# --- Geospatial working files -------------------------------------------------
*.tif
*.tiff

# --- OS and editors -----------------------------------------------------------
.DS_Store
.vscode/
.idea/

# Documentation site (mkdocs)
/site/


# Runtime cache (DATA_DIR): dataset clips, OSM extracts, derived products. Safe to delete.
.cache

# Large reference spreadsheets (over GitHub's 100 MB limit): kept locally only
docs/planning/data-references/wapor/WaPOR_catalog_full.xlsx
