# GEIDA analysis worker (Celery, Redis broker). Runs analysis modules queued by the API.
#   sudo cp deploy/systemd/geida-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now geida-worker
# Adjust User, paths and the conda env location to the server.

[Unit]
Description=GEIDA analysis worker (Celery)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User=ecduser
Group=ecduser
WorkingDirectory=/home/ecduser/isdb_geida/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/home/ecduser/miniconda3/envs/geida/bin/celery -A config worker -l info -c 2
# Let a running analysis finish (up to ANALYSIS_TIME_LIMIT) before a restart kills it.
TimeoutStopSec=300
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
